# Database
dbhost=localhost
dbport=3306
dbname=your_db_name
dbuser=root
dbpassword=yourpassword

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
PORT=8000
HOST=127.0.0.1

# OpenAI (for AI engine)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-2024-tax-reform
JWT_ALGORITHM=HS256 #example
JWT_EXPIRE_DAYS=7 #example

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100 #example
RATE_LIMIT_PER_HOUR=1000 #example

# Security
PASSWORD_RESET_EXPIRE_MINUTES=30 #example
MAX_LOGIN_ATTEMPTS=5 #example
ACCOUNT_LOCKOUT_MINUTES=15 #example